{% liquid
  assign product = block.settings.product
-%}

{% capture children %}
  {% content_for 'blocks', closest.product: product %}
{% endcapture %}

{% render 'product-card', children: children, product: product %}

{% schema %}
{
  "name": "Product card",
  "blocks": [
    {
      "type": "quick-add"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Init color scheme",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Padding"
    }
  ],
  "presets": [
    {
      "name": "Product card",
      "category": "Product",
      "blocks": {
        "product-card-gallery": {
          "type": "_product-card-gallery"
        },
        "group": {
          "type": "_product-card-group",
          "settings": {
            "content_direction": "column"
          },
          "blocks": {
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "type_preset": "h5"
              }
            },
            "price": {
              "type": "price"
            }
          },
          "block_order": ["product_title", "price"]
        }
      },
      "block_order": ["product-card-gallery", "group"]
    }
  ]
}
{% endschema %}
